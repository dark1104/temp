*** Test Cases ***
Resmon_CPU_Status_Critical_Rise_And_Fall_Time_Stamp_After_Restart.robot
    STEP_1_Verify_RG_Obtained_WAN_IP
    STEP_2_Configure_NTP_Servers_And_Check_Time_Status
    STEP_3_Verify_Device_Date_And_Time
    STEP_4_Set_The_CriticalRiseThreshold_Value
    STEP_5_Check_CPU_CriticalRiseTimeStamp
    STEP_6_Set_The_CriticalFallThreshold_Value
    STEP_7_Check_CPU_CriticalFallTimeStamp
    STEP_8_Verify_File_Rm_Pidstat_Full_Is_Created
    STEP_9_Restart_RG_Through_CLI

*** Keywords ***
Common_Setup
    Log To Console    ***Common Setup***
    Common_CLI_RG_Connect
    Common_CLI_RG_Supplicant_OFF    ${RG_Supplicant_Cmd}

Common_Cleanup   
    Run Keywords    Teardown
    ...    AND    Common_CLI_RG_Disconnect

STEP_1_Verify_RG_Obtained_WAN_IP
    Log To Console    "***STEP_1: Verify_RG_Obtained_WAN_IP***"
    ${RG_WAN_IPAddress}    Check_WAN_IP    ${TR69_WAN_IP}
    Set Global Variable    ${RG_WAN_IPAddress}
    Log To Console    "The WAN IP addresses assigned: ${RG_WAN_IPAddress}"

STEP_2_Configure_NTP_Servers_And_Check_Time_Status
    Log To Console    "***STEP_2: Configure_NTP_Servers_And_Check_Time_Status***"
    UBus_SetParameterValue    SPV    ${UBus_Time_Client_1_Servers}    ${NTP_Servers_IP_PRPL}
    :FOR    ${Index}    IN RANGE    0    10
    \    Sleep    10s  
    \    ${NTP_Status}   UBus_GetParameterValue    GPV_Return   ${UBus_Time_Status}
    \    Exit For Loop If    '${NTP_Status}'=='${NTP_Synchronized}'
    Run Keyword if  '${NTP_Status}'=='${NTP_Synchronized}'
    ...     Log     -pass "NTP Server is Synchronized"
    ...     ELSE
    ...     Fail    -fail "NTP Server is not Synchronized"

STEP_3_Verify_Device_Date_And_Time
    Log To Console    "***STEP_3: Verify_Device_Date_And_Time***"
    ${RG_Date}    CLI_Bash_Execute    date +%F
    ${RG_Time}    CLI_Bash_Execute    date +%T
    @{RG_Date}    Split To Lines    ${RG_Date}
    ${RG_Date}    Get From List    ${RG_Date}    0
    ${RG_Time_Seconds}    Convert Time    ${RG_Time}
    Set Global Variable    ${RG_Date}
    Set Global Variable    ${RG_Time_Seconds}

STEP_4_Set_The_CriticalRiseThreshold_Value
    Log To Console    "***STEP_4: Set_The_CriticalRiseThreshold_Value***"
    UBus_SetParameterValue    SPV    ${UBus_CPU_1_CriticalFallThreshold}    ${VAR_ONE}
    UBus_SetParameterValue    SPV    ${UBus_CPU_1_CriticalRiseThreshold}    ${VAR_TWO}
    Sleep    60s

STEP_5_Check_CPU_CriticalRiseTimeStamp
    Log To Console    "***STEP_5: Check_CPU_CriticalRiseTimeStamp***"
    ${Return_value}    UBus_GetParameterValue    GPV_Return    ${UBus_CPU_1_CriticalRiseTimeStamp}
    ${Return_Value}    Split String    ${Return_Value}    .
    ${ReturnValue_Date}    Get From List    ${Return_Value}    ${VAR_ZERO}   
    ${Current_Date}    Convert Date    ${ReturnValue_Date}    %Y-%m-%d
    ${Current_Time}    Convert Date    ${ReturnValue_Date}    %H:%M:%S
    ${Current_Time}    Convert Time    ${Current_Time}
    Run Keyword If    '${RG_Date}'=='${Current_Date}' and ${RG_Time_Seconds}<${Current_Time}
    ...    Log    -pass "Current date and time have been updated correctly"
    ...    ELSE
    ...    Run Keyword And Continue on Failure     Fail    -fail "The current date and time have not been updated properly"
    Set Global Variable    ${Current_Date}
    Set Global Variable    ${Current_Time}

STEP_6_Set_The_CriticalFallThreshold_Value
    Log To Console    "***STEP_6: Verify_CriticalRiseThreshold***"
    UBus_SetParameterValue    SPV    ${UBus_CPU_1_CriticalRiseThreshold}    ${Default_CriticalRiseThreshold}
    UBus_SetParameterValue    SPV    ${UBus_CPU_1_CriticalFallThreshold}    ${Default_CriticalFallThreshold}
    Sleep    90s

STEP_7_Check_CPU_CriticalFallTimeStamp
    Log To Console    "***STEP_7: Check_CPU_CriticalRiseTimeStamp***"
    ${Return_value}    UBus_GetParameterValue    GPV_Return    ${UBus_CPU_1_CriticalFallTimeStamp}
    ${Return_Value}    Split String    ${Return_Value}    .
    ${ReturnValue_Date}    Get From List    ${Return_Value}    ${VAR_ZERO}   
    ${Current_Date}    Convert Date    ${ReturnValue_Date}    %Y-%m-%d
    ${Current_Time}    Convert Date    ${ReturnValue_Date}    %H:%M:%S
    ${Current_Time}    Convert Time    ${Current_Time}
    Run Keyword If    '${RG_Date}'=='${Current_Date}' and ${RG_Time_Seconds}<${Current_Time}
    ...    Log    -pass "Current date and time have been updated correctly"
    ...    ELSE
    ...    Run Keyword And Continue on Failure     Fail    -fail "The current date and time have not been updated properly"
    Set Global Variable    ${Current_Date}
    Set Global Variable    ${Current_Time}

STEP_8_Verify_File_Rm_Pidstat_Full_Is_Created
    Log To Console    "*** STEP_8: Verify_File_Rm_Pidstat_Full_Is_Created ***"
    ${Return}    CLI_Bash_Execute     ls -l ${PIDStat_File_Path}
    ${Status}    Run Keyword and Return Status    Should Contain    ${Return}    ${PIDStat_File_Name}
    Run Keyword If    '${Status}' == '${True}'
    ...    Log    -pass "The File is created as expected"
    ...    ELSE
    ...    Run Keyword And Continue On Failure    FAIL    -fail "The File is not created is not expected"

STEP_9_Restart_RG_Through_CLI
    Log To Console  "***STEP_9: Restart_RG_Through_CLI***"
    Common_RG_Restart    ${RG_Restart}
    Common_CLI_RG_Connect
    STEP_5_Check_CPU_CriticalRiseTimeStamp
    STEP_7_Check_CPU_CriticalFallTimeStamp
    STEP_8_Verify_File_Rm_Pidstat_Full_Is_Created

Teardown
    Log To Console    "***Revert back configurations***"
    TR069_SetParameterValue    SPV    ${TR69_Time_NTPServer1}     ${NTP_Domain_Name_Server1}
    TR069_SetParameterValue    SPV    ${TR69_Time_NTPServer2}     ${NTP_Domain_Name_Server2}
